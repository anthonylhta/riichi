{
	"name": "riichi",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude && eslint .",
		"format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
		"test": "vitest run",
		"test:watch": "vitest",
		"puzzles:check": "PUZZLES_PRINT=1 vitest run src/lib/server/puzzles.test.ts",
		"db:push": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' drizzle-kit push",
		"db:studio": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^20",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vite-plugin-wasm": "^3.6.0",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.100.1",
		"@neondatabase/serverless": "^1.1.0",
		"drizzle-orm": "^0.45.2",
		"mahjong-tile-efficiency": "^1.0.3",
		"riichi-rs-bundlers": "^2.1.0",
		"svelte-clerk": "^1.1.9"
	}
}
